# ─────────────────────────────────────────────────────────────────────────────
# ESG Catalyst — environment variable reference
#
# Copy this file to .env and fill in the values for your environment.
# Never commit .env — it contains real secrets.
#
# Variable names map directly to Settings fields in backend/app/config.py
# (upper-cased).  All values shown here are placeholders or defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/esg_catalyst
# SQLite (local dev fallback — omit DATABASE_URL to use this default):
# DATABASE_URL=sqlite+aiosqlite:///./esg_catalyst.db

# ── Redis / Celery broker ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM — OpenRouter + Groq ───────────────────────────────────────────────────
# OpenRouter API key — required only for openrouter/ model IDs.
OPENROUTER_API_KEY=sk-or-...

# Groq API key — free key at https://console.groq.com
# Required for groq/ model IDs (the current defaults).
GROQ_API_KEY=gsk_...

# Primary extraction model (M3).
MODEL_EXTRACTION=groq/llama-3.1-8b-instant

# Free-tier fallback — activated on HTTP 402 / Groq rate-limit from primary.
MODEL_EXTRACTION_FALLBACK=openrouter/qwen/qwen-2.5-7b-instruct:free

# Scoring / gap-analysis model (M4).
MODEL_SCORING=groq/llama-3.3-70b-versatile

# Report narrative model (M5).
MODEL_REPORT=groq/llama-3.3-70b-versatile

# Free-tier fallback for report narrative generation.
MODEL_REPORT_FALLBACK=groq/llama-3.1-8b-instant

# Per-task completion-length caps. An UNCAPPED request defaults to the model's
# full output ceiling (e.g. 64000 tokens for Claude Sonnet); OpenRouter then
# reserves credit for that whole ceiling and a tiny prompt 402s on a low
# balance ("requires more credits, or fewer max_tokens"). These caps fix that
# and bound runaway generations. Extraction returns one small JSON per
# indicator; report narratives are generated one section per call. Raise a cap
# if you ever see a truncated response.
MODEL_EXTRACTION_MAX_TOKENS=2000
MODEL_SCORING_MAX_TOKENS=2000
MODEL_REPORT_MAX_TOKENS=3000

# ── Vector store (ChromaDB) ──────────────────────────────────────────────────
# Host dev: localhost. Inside docker-compose: chromadb (service name).
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── Embeddings ───────────────────────────────────────────────────────────────
# Language-routed: EN chunks → EMBEDDING_MODEL_EN, AR chunks → EMBEDDING_MODEL_AR.
# Run `python scripts/download_models.py` once per machine to cache both models.

# English embedding model (768d, ~1.6 GB RAM).
EMBEDDING_MODEL_EN=intfloat/multilingual-e5-base

# Arabic embedding model (1024d, ~2.6 GB RAM).
# bge-m3 lifted AR retrieval R@5 from 0.80 → 0.90 vs e5-base (M2-B1 benchmark).
EMBEDDING_MODEL_AR=BAAI/bge-m3

# Legacy single-model alias — kept for back-compat, mirrors EMBEDDING_MODEL_EN.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# ── Chunker ──────────────────────────────────────────────────────────────────
# sentence_window (default, A2 winner) or block_merge (legacy).
# Switching strategy is an env-var change — no code change required.
CHUNK_STRATEGY=sentence_window

# sentence_window knobs (ignored when CHUNK_STRATEGY=block_merge).
CHUNK_WINDOW_SENTENCES=3
CHUNK_STRIDE_SENTENCES=1
CHUNK_MAX_CHARS=1500

# block_merge knobs (ignored when CHUNK_STRATEGY=sentence_window).
CHUNK_SIZE_CHARS=2000
CHUNK_OVERLAP_CHARS=200

# ── Extraction (M3 per-indicator retrieval) ──────────────────────────────────
# Chunks retrieved from ChromaDB per indicator.
# 3 = faster / lower cost; 5 = more context for difficult indicators.
EXTRACTION_TOP_K=3

# Minimum chunks required to issue an LLM extraction call.
# If ChromaDB returns fewer, the indicator is skipped (status=missing).
EXTRACTION_MIN_CHUNKS=1

# Concurrent LLM extraction calls per pipeline run.
# Local Ollama: 4–6 is safe. Remote APIs (Groq/OpenRouter): 2–3.
EXTRACTION_CONCURRENCY=4

# ── Auth ─────────────────────────────────────────────────────────────────────
# HS256 JWT signing secret. MUST be overridden in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# JWT access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── MLflow experiment tracking ───────────────────────────────────────────────
# Host dev: http://localhost:5001. Inside docker-compose: http://mlflow:5001.
# mlflow_tracker.py wraps all calls in try/except so a dead server is non-fatal.
MLFLOW_TRACKING_URI=http://localhost:5001

# ── Application ──────────────────────────────────────────────────────────────
# One of: development | staging | production | test
ENVIRONMENT=development

# Maximum upload file size in MB.
MAX_UPLOAD_SIZE_MB=50

# Minimum LLM extraction confidence to mark a metric 'extracted' vs 'ambiguous'.
# Does NOT gate the M2 classifier (that uses a separate internal threshold).
CONFIDENCE_THRESHOLD=0.80

# ── M5 PDF renderer backend ───────────────────────────────────────────────────
# auto       — WeasyPrint primary, PyMuPDF Story fallback (default, recommended).
# weasyprint — WeasyPrint only; raises if GTK3 is unavailable.
# pymupdf    — Skip WeasyPrint entirely. One-line revert if WeasyPrint regresses.
PDF_BACKEND=auto
