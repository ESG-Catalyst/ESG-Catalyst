# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/esg_catalyst

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM — OpenRouter (free-tier extraction) + Groq (free scoring + report)
OPENROUTER_API_KEY=sk-or-...
# Extraction — Llama 3.1 8B instant via Groq (free, fast, Arabic + English)
MODEL_EXTRACTION=groq/llama-3.1-8b-instant
# Fallback: Qwen 2.5 7B on OpenRouter (strong Arabic, fires on Groq rate limit)
MODEL_EXTRACTION_FALLBACK=openrouter/qwen/qwen-2.5-7b-instruct:free
# Scoring / Gap Analysis — Llama 3.3 70B via Groq (free, fast, strong reasoning)
MODEL_SCORING=groq/llama-3.3-70b-versatile
# Narrative Report — Llama 3.3 70B via Groq (free, best open-source prose)
MODEL_REPORT=groq/llama-3.3-70b-versatile
MODEL_REPORT_FALLBACK=groq/llama-3.1-8b-instant

# Groq API key — get a free key at https://console.groq.com
GROQ_API_KEY=gsk_...

# Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8001

# Embeddings (local models, no API key needed). Language-routed:
# EN chunks → EMBEDDING_MODEL_EN, AR chunks → EMBEDDING_MODEL_AR.
# Run `python scripts/download_models.py` once per machine to cache both.
EMBEDDING_MODEL_EN=intfloat/multilingual-e5-base
EMBEDDING_MODEL_AR=BAAI/bge-m3
# Legacy single-model alias — kept for back-compat, mirrors EN.
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Auth
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5001

# App
ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=50
CONFIDENCE_THRESHOLD=0.80

# M5 PDF backend. auto = WeasyPrint primary, PyMuPDF fallback.
# Set to "pymupdf" as a one-line revert if WeasyPrint regresses.
# Set to "weasyprint" to fail loudly instead of silently falling back.
PDF_BACKEND=auto
