# ============================================================
# ESG Catalyst — FastAPI service (M6 API)
# ============================================================
# Serves /api/v1/... endpoints. Stateless: file storage lives on
# the shared ./data volume; Postgres/Redis are external services
# reached via the docker-compose network.
#
# Build:   docker compose build api
# Run:     docker compose up -d api
# Inspect: docker compose logs -f api
# ============================================================

FROM python:3.11-slim

# Standard Python container hygiene + put backend/ on PYTHONPATH so
# `from app.main import app` resolves the same way it does on the host
# (matches the CLAUDE.md note about PYTHONPATH=backend).
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend

# build-essential covers anything in requirements.txt that lacks a wheel.
# curl is used by the healthcheck below.
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# API only needs the base deps — NO torch / transformers / mlflow.
# This shrinks the image from ~10GB to ~500MB. The api/* routes
# enqueue Celery tasks by name (celery_app.send_task), so they
# never import app.workers.tasks (which would pull in the pipeline).
COPY requirements-base.txt .
RUN pip install --upgrade pip && pip install -r requirements-base.txt

# API only needs backend code. ./data is mounted at runtime as a volume,
# so we deliberately do NOT bake uploads/generated_reports into the image.
COPY backend ./backend

EXPOSE 8000

# Hit FastAPI's /health route to determine readiness.
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]